# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# LLM Model Lists (comma-separated, first is default)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-1.5-flash,gemini-1.5-pro
OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo
CLAUDE_MODELS=claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022,claude-3-opus-20240229


# Cost Configuration (per 1M tokens)
GEMINI_INPUT_COST_PER_M_TOKENS=0.30
GEMINI_OUTPUT_COST_PER_M_TOKENS=2.50
OPENAI_INPUT_COST_PER_M_TOKENS=2.50
OPENAI_OUTPUT_COST_PER_M_TOKENS=10.00
CLAUDE_INPUT_COST_PER_M_TOKENS=3.00
CLAUDE_OUTPUT_COST_PER_M_TOKENS=15.00


# Server Configuration
PORT=8000
DEBUG=True

# File Storage Configuration
DATA_DIR=./data

