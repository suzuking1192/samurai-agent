{
  "name": "samurai-agent",
  "displayName": "Samurai Agent: Tackle complex bugs, features & refactors",
  "description": "Deep codebase analysis for debugging, planning & refactoring - references YOUR code, not generic patterns",
  "version": "0.0.17",
  "publisher": "SamuraiAgent",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai-coding",
  "copilot",
  "cursor", 
  "code-analysis",
  "debugging",
  "refactoring",
  "codebase",
  "planning",
  "architecture",
  "bug-fix"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suzuking1192/samurai-agent"
  },
  "homepage": "https://github.com/suzuking1192/samurai-agent",
  "bugs": {
    "url": "https://github.com/suzuking1192/samurai-agent/issues"
  },
  "icon": "icon.png",
  "activationEvents": [
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
    ],
    "configuration": {
      "title": "Samurai Agent",
      "properties": {
        "samurai-agent.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable anonymous usage analytics to help improve Samurai Agent. No personal data is collected."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "samurai-agent",
          "title": "Samurai Agent",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "samurai-agent": [
        {
          "id": "samurai-agent.agentPanel",
          "name": "Agent Panel",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node scripts/build-with-env.js webpack",
    "watch": "node scripts/build-with-env.js webpack --watch",
    "package": "node scripts/build-with-env.js webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:vscode": "vscode-test",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.34.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.2",
    "openai": "^5.23.0",
    "posthog-node": "^3.5.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.22.4"
  }
}
