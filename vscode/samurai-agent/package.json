{
  "name": "samurai-agent",
  "displayName": "Samurai Agent",
  "description": "AI tool for spec-driven development: debugs requirements to prevent messy AI-generated code",
  "version": "0.0.1",
  "publisher": "samurai-agent",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:samurai-agent.helloWorld"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "samurai-agent.helloWorld",
        "title": "Hello World",
        "category": "Samurai Agent"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "samurai-agent",
          "title": "Samurai Agent",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "samurai-agent": [
        {
          "id": "samurai-agent.agentPanel",
          "name": "Agent Panel",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:vscode": "vscode-test",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.34.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.2",
    "openai": "^5.23.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.22.4"
  }
}
